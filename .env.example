# Copiez ce fichier en `.env` pour le développement local, et reportez les mêmes
# variables dans Vercel → Settings → Environment Variables pour la production.

# --- Base de données (obligatoire en production) ---
# Sans elle, le serveur écrit dans server/data/*.json — suffisant en local,
# mais perdu à chaque redéploiement sur Vercel.
MONGODB_URI=

# --- Sécurité de l'espace admin ---
JWT_SECRET=une-longue-phrase-aleatoire-a-changer
ADMIN_PASSWORD=le-premier-mot-de-passe-de-paule

# --- Cloudinary : hébergement des photos et vidéos importées depuis l'admin ---
# Dashboard Cloudinary → Product Environment Credentials.
# Soit les trois variables ci-dessous…
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# …soit l'URL unique (elle contient déjà les trois) :
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Dossier Cloudinary dans lequel les médias du site sont déposés (optionnel)
# CLOUDINARY_FOLDER=pauleackerman

# Plafonds d'import, en octets (optionnel — valeurs par défaut : 10 Mo / 100 Mo)
# MAX_IMAGE_SIZE=10485760
# MAX_VIDEO_SIZE=104857600

# --- Assistants IA de l'admin ---
# Claude : assistant de RECHERCHE (trouver de nouveaux clients, auditer leur présence en ligne).
# Clé sur https://console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=
# Yann fait le travail lourd (recherche web, audits) : modèle complet par défaut
# CLAUDE_MODEL=claude-opus-5-5

# OpenAI : DIAGNOSTIC des demandes clients + AGENDA & relances (une seule clé pour les deux).
# Clé sur https://platform.openai.com → API keys.
OPENAI_API_KEY=
# Nadia et Awa ont des tâches simples : modèle léger par défaut
# OPENAI_MODEL_DIAGNOSTIC=gpt-5.4-mini
# OPENAI_MODEL_AGENDA=gpt-5.4-mini
# (ou OPENAI_MODEL=... pour les deux à la fois)
# Niveau de réflexion : none | minimal | low | medium | high | xhigh (ou « off » pour un modèle sans raisonnement)
# OPENAI_REASONING_EFFORT=low
# Pour afficher un coût estimé dans l'admin : tarifs du modèle, en $ par million de jetons
# OPENAI_PRICE_INPUT=
# OPENAI_PRICE_OUTPUT=

# Clés dédiées par assistant (facultatif, pour suivre les dépenses séparément) :
# ANTHROPIC_API_KEY_PROSPECTION=
# OPENAI_API_KEY_DIAGNOSTIC=
# OPENAI_API_KEY_AGENDA=

# Budget quotidien par assistante, en tokens (garde-fou de dépense) :
# au-delà, elle s'arrête jusqu'au lendemain.
# AI_DAILY_TOKENS=1000000

# --- Alertes email (nouvelle demande, nouveau rendez-vous) via Resend — facultatif ---
# Clé sur https://resend.com → API Keys. Sans domaine vérifié, Resend n'envoie
# qu'à l'adresse du compte Resend : mettez celle de Paule.
# RESEND_API_KEY=
# NOTIFY_EMAIL=
# NOTIFY_FROM=Portfolio Paule Ackerman <onboarding@resend.dev>
# SITE_URL=https://www.pauleackerman.com

# --- Google Agenda : chaque rendez-vous ajouté à l'agenda de Paule — facultatif ---
# 1. console.cloud.google.com : créer un projet, activer « Google Calendar API ».
# 2. IAM et administration → Comptes de service : créer un compte, puis une clé JSON.
# 3. Google Agenda → Paramètres et partage → partager l'agenda avec l'adresse du
#    compte de service, droit « Apporter des modifications aux événements ».
# GOOGLE_CALENDAR_ID=adresse-gmail-de-paule@gmail.com
# Contenu du fichier JSON de la clé (tel quel, ou encodé en base64) :
# GOOGLE_SERVICE_ACCOUNT=

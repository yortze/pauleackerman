# Copiez ce fichier en `.env` pour le développement local, et reportez les mêmes
# variables dans Vercel → Settings → Environment Variables pour la production.

# --- Base de données (obligatoire en production) ---
# Sans elle, le serveur écrit dans server/data/*.json — suffisant en local,
# mais perdu à chaque redéploiement sur Vercel.
MONGODB_URI=

# --- Sécurité de l'espace admin ---
JWT_SECRET=une-longue-phrase-aleatoire-a-changer
ADMIN_PASSWORD=le-premier-mot-de-passe-de-paule

# --- Cloudinary : hébergement des photos et vidéos importées depuis l'admin ---
# Dashboard Cloudinary → Product Environment Credentials.
# Soit les trois variables ci-dessous…
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# …soit l'URL unique (elle contient déjà les trois) :
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Dossier Cloudinary dans lequel les médias du site sont déposés (optionnel)
# CLOUDINARY_FOLDER=pauleackerman

# Plafonds d'import, en octets (optionnel — valeurs par défaut : 10 Mo / 100 Mo)
# MAX_IMAGE_SIZE=10485760
# MAX_VIDEO_SIZE=104857600
